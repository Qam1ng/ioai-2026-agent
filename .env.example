# Copy to .env (which is gitignored) and fill in.
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-opus-4-8

# ByteDance ModelHub crawl endpoint (backend: crawl). Full URL including ?ak=.
CRAWL_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl?ak=REPLACE_ME
CRAWL_MODEL=gemini-3.1-p
# Parallel in-flight requests across the whole swarm; the endpoint is qpm-limited.
CRAWL_CONCURRENCY=2
